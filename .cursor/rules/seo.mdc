## 3. `generateMetadata` on dynamic routes — blog

Every dynamic route in the blog **must** implement `generateMetadata`. The post `slug` is the canonical URL. Use the `metaTitle`, `metaDescription`, and `ogImageUrl` fields already provided by the backend (`IPostDetail`).

```tsx
// apps/blog/app/posts/[slug]/page.tsx
import type { Metadata } from 'next';
import { fetchPostBySlug, fetchPosts } from '@/modules/posts/services/posts.service';
import { notFound } from 'next/navigation';

interface IProps {
  params: Promise<{ slug: string }>;
}

export async function generateMetadata({ params }: IProps): Promise<Metadata> {
  const { slug } = await params;
  const post = await fetchPostBySlug(slug).catch(() => null);
  if (!post) return { title: 'Post not found' };

  const title = post.metaTitle ?? post.title;
  const description = post.metaDescription ?? post.excerpt;
  const canonicalUrl = `${process.env.NEXT_PUBLIC_SITE_URL}/${slug}`;
  const publishedTime = post.publishedAt ?? post.createdAt;

  return {
    title,
    description,
    alternates: {
      canonical: canonicalUrl,
    },
    openGraph: {
      type: 'article',
      title,
      description,
      url: canonicalUrl,
      locale: 'es_ES',
      publishedTime,
      modifiedTime: post.updatedAt,
      authors: [`${post.admin.name} ${post.admin.lastName}`],
      tags: post.tags.map((t) => t.name),
      images: post.ogImageUrl
        ? [{ url: post.ogImageUrl, width: 1200, height: 630, alt: title }]
        : [],
    },
    twitter: {
      card: 'summary_large_image',
      title,
      description,
      images: post.ogImageUrl ? [post.ogImageUrl] : [],
    },
    // Unpublished posts must not be indexed
    robots: { index: post.published, follow: true },
  };
}

// Required for SSG — fetches all published slugs at build time.
// Do NOT set dynamicParams = false. The default (true) allows Next.js to
// SSR-render any slug not pre-generated (e.g. a post published after the last build),
// then cache it automatically via the revalidate set in fetchPostBySlug.
//
// The API enforces a max limit of 30 items per page — paginate to collect all slugs.
export async function generateStaticParams(): Promise<Array<{ slug: string }>> {
  const first = await fetchPosts({ page: 1, limit: 30 });
  const remaining = await Promise.all(
    Array.from({ length: first.meta.totalPages - 1 }, (_, i) =>
      fetchPosts({ page: i + 2, limit: 30 })
    )
  );
  return [first, ...remaining].flatMap((r) => r.items).map((p) => ({ slug: p.slug }));
}
```

### Category or tag pages

If routes like `/categoria/[slug]` exist, they must also implement `generateMetadata`:

```tsx
export async function generateMetadata({ params }: IProps): Promise<Metadata> {
  const { slug } = await params;
  const canonicalUrl = `${process.env.NEXT_PUBLIC_SITE_URL}/categoria/${slug}`;
  return {
    title: `Posts sobre ${slug}`,   // UI copy — Spanish is correct here
    alternates: { canonical: canonicalUrl },
    openGraph: { url: canonicalUrl },
  };
}
```

