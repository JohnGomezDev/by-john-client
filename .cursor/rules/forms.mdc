# Forms — React Hook Form

## Rules

- Use `react-hook-form` for all forms in `apps/admin`.
- No external schema library (no Zod, no Yup) — validate with RHF's built-in `validate` rules.
- Forms are always Client Components (`'use client'`).
- Connect form submission to a TanStack Query mutation — never call the service directly from the form.
- Never manage form loading/error state manually with `useState` — use `formState` from RHF and `isPending` from the mutation.

## Pattern — create form (admin)

```tsx
// apps/admin/src/modules/admin/components/PostForm.tsx
'use client';

import { useForm, type SubmitHandler } from 'react-hook-form';
import { Button }   from '@repo/ui/components/ui/button';
import { Input }    from '@repo/ui/components/ui/input';
import { Textarea } from '@repo/ui/components/ui/textarea';
import { useCreatePost } from '../hooks/use-create-post';
import type { ICreatePostPayload } from '../types/admin.types';

interface IPostFormProps {
  onSuccess?: () => void;
}

export function PostForm({ onSuccess }: IPostFormProps): React.JSX.Element {
  const { mutate: createPost, isPending, isError, error } = useCreatePost();

  const {
    register,
    handleSubmit,
    reset,
    formState: { errors },
  } = useForm<ICreatePostPayload>({
    defaultValues: { title: '', content: '', slug: '' },
  });

  const onSubmit: SubmitHandler<ICreatePostPayload> = (data): void => {
    createPost(data, {
      onSuccess: () => {
        reset();
        onSuccess?.();
      },
    });
  };

  return (
    <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">

      <div>
        <Input
          {...register('title', {
            required: 'El título es obligatorio',
            maxLength: { value: 255, message: 'Máximo 255 caracteres' },
          })}
          placeholder="Título del post"
        />
        {errors.title && <p className="text-sm text-destructive">{errors.title.message}</p>}
      </div>

      <div>
        <Textarea
          {...register('content', { required: 'El contenido es obligatorio' })}
          placeholder="Contenido"
          rows={10}
        />
        {errors.content && <p className="text-sm text-destructive">{errors.content.message}</p>}
      </div>

      <div>
        <Input
          {...register('slug', {
            pattern: {
              value: /^[a-z0-9]+(?:-[a-z0-9]+)*$/,
              message: 'Slug inválido — solo minúsculas, números y guiones',
            },
          })}
          placeholder="slug-del-post (opcional)"
        />
        {errors.slug && <p className="text-sm text-destructive">{errors.slug.message}</p>}
      </div>

      {isError && (
        <p className="text-sm text-destructive">
          {(error as Error).message ?? 'Ocurrió un error al guardar el post.'}
        </p>
      )}

      <Button type="submit" disabled={isPending}>
        {isPending ? 'Guardando...' : 'Crear post'}
      </Button>

    </form>
  );
}
```

## Pattern — edit form with pre-populated data (admin)

```tsx
// apps/admin/src/modules/admin/components/EditPostForm.tsx
'use client';

import { useForm, type SubmitHandler } from 'react-hook-form';
import { useUpdatePost } from '../hooks/use-update-post';
import type { IPost, IUpdatePostPayload } from '../types/admin.types';

interface IEditPostFormProps {
  post: IPost;
  onSuccess?: () => void;
}

export function EditPostForm({ post, onSuccess }: IEditPostFormProps): React.JSX.Element {
  const { mutate: updatePost, isPending } = useUpdatePost();

  const { register, handleSubmit, formState: { errors, isDirty } } = useForm<IUpdatePostPayload>({
    defaultValues: { title: post.title, content: post.content, slug: post.slug },
  });

  const onSubmit: SubmitHandler<IUpdatePostPayload> = (data): void => {
    updatePost({ id: post.id, payload: data }, { onSuccess });
  };

  return (
    <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
      {/* same fields as PostForm */}
      <Button type="submit" disabled={isPending || !isDirty}>
        {isPending ? 'Guardando...' : 'Guardar cambios'}
      </Button>
    </form>
  );
}
```

## Validation rules reference

| Field | Rules |
|---|---|
| `title` | `required`, `maxLength: 255` |
| `content` | `required` |
| `slug` | optional, pattern `/^[a-z0-9]+(?:-[a-z0-9]+)*$/` |

## Rules summary

- Use `register` + inline `validate` options — no schema libraries.
- Use `formState.errors` for field-level feedback, `isError` from the mutation for API-level feedback.
- Disable the submit button while `isPending` or (on edit forms) when `!isDirty`.
- Always call `reset()` after a successful create to clear the form.
- Forms never manage their own loading/success/error booleans with `useState`.
- shadcn/ui components used in forms are imported from `@repo/ui` — not from local paths.
