## apps/blog — Public blog

- Uses `@repo/ui` for UI primitives (shadcn/ui) + own style customization.
- Read-only — no write operations from the blog. No Redux.
- The post list and detail pages are Server Components that use React's `cache` or a direct service call (not `useQuery`) for SSR/SSG.
- The detail page renders Markdown/HTML content from the API.
- SEO: `generateMetadata` must be implemented on every dynamic route.

```tsx
// apps/blog/src/app/[slug]/page.tsx
import { fetchPostBySlug } from '@/modules/blog/services/blog.service';
import { PostDetail } from '@/modules/blog/components/PostDetail';
import { notFound } from 'next/navigation';
import type { Metadata } from 'next';

interface IProps {
  params: Promise<{ slug: string }>;
}

export async function generateMetadata({ params }: IProps): Promise<Metadata> {
  const { slug } = await params;
  const post = await fetchPostBySlug(slug).catch(() => null);
  if (!post) return { title: 'Post no encontrado' };
  return { title: post.title, description: post.excerpt };
}

export default async function PostPage({ params }: IProps): Promise<React.JSX.Element> {
  const { slug } = await params;
  const post = await fetchPostBySlug(slug).catch(() => null);
  if (!post) notFound();
  return <PostDetail post={post} />;
}
```

**`generateStaticParams`** must be implemented on the detail route to enable SSG:

```tsx
export async function generateStaticParams(): Promise<Array<{ slug: string }>> {
  const posts = await fetchPosts();
  return posts.map((p) => ({ slug: p.slug }));
}
```

