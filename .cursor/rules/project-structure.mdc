          services/
            landing.service.ts
          types/
            landing.types.ts
          constants/
            landing.query-keys.ts
      lib/
        api/
          api-client.ts         # axios instance without auth interceptor
        providers/
          Providers.tsx         # QueryClientProvider
        constants/
          routes.constants.ts   # web routes
      styles/
        globals.css

  blog/                         # Public blog — shadcn/ui + extra customization
    src/
      app/
